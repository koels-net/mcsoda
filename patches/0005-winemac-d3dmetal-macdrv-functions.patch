+static LSTATUS WINAPI my_RegCreateKeyExA(HKEY p1, LPCSTR p2, DWORD p3, LPSTR p4, DWORD p5, DWORD p6,
+                                         LPSECURITY_ATTRIBUTES p7, HKEY *p8, LPDWORD p9)
+{
