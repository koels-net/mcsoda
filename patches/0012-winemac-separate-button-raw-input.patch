+/* Button/wheel locations are cooked cursor positions, not raw motion. A
+ * clipped or warped cursor can differ from the server position even without
+ * physical movement. Keep those coordinates out of the raw-input stream. */
+static void send_mouse_button_input(HWND hwnd, const macdrv_event *event, UINT flags,
+                                    int x, int y, DWORD data, unsigned long time)
+{
+    INPUT raw = {0};
+
+    send_mouse_input(hwnd, event->window, flags | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MOVE,
+                     x, y, data, FALSE, time, SEND_HWMSG_NO_RAW);
+
+    raw.type = INPUT_MOUSE;
+    raw.mi.dwFlags = flags;
+    raw.mi.mouseData = data;
+    raw.mi.time = time;
+    NtUserSendHardwareInput(0, SEND_HWMSG_NO_MSG, &raw, 0);
+}
+
+
