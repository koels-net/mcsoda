+                mouseMoveDeltaY -= dy / scale;
 
-                event = macdrv_create_event(MOUSE_MOVED_RELATIVE, targetWindow);
-                event->mouse_moved.x = mouseMoveDeltaX * scale;
-                event->mouse_moved.y = mouseMoveDeltaY * scale;
